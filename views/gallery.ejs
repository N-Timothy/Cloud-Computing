<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Gallery</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="container">
      <header>
        <h1>My Gallery</h1>
        <p>Connected to bucket: <strong><%= bucketName %></strong></p>
      </header>

      <section class="upload-section">
        <h2>Upload New File</h2>
        <form
          action="/gallery/upload"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="form-group">
            <input type="file" name="file" required />
            <button type="submit" class="btn primary">Upload</button>
          </div>
        </form>
      </section>

      <section class="gallery-items">
        <h2>Your Files</h2>

        <% if (items.length === 0) { %>
        <p>No files found in your bucket. Upload something to get started!</p>
        <% } else { %>
        <div class="gallery-grid">
          <% items.forEach(item => { %>
          <div class="gallery-item">
            <div class="item-preview">
              <% if (item.key.match(/\.(jpeg|jpg|gif|png)$/i)) { %>
              <img src="<%= item.url %>" alt="<%= item.key %>" />
              <% } else { %>
              <div class="file-icon">
                <%= item.key.split('.').pop().toUpperCase() %>
              </div>
              <% } %>
            </div>
            <div class="item-info">
              <p class="item-name"><%= item.key %></p>
              <p class="item-size"><%= Math.round(item.size/1024) %> KB</p>
              <div class="item-actions">
                <a href="<%= item.url %>" class="btn small" download
                  >Download</a
                >
                <form
                  action="/gallery/delete/<%= encodeURIComponent(item.key) %>"
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this file?')"
                >
                  <button type="submit" class="btn small danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
    </div>
  </body>
</html>
