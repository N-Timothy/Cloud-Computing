<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>S3 Gallery</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="container">
      <h1>Welcome to S3 Gallery</h1>

      <% if (user) { %>
      <p>You are logged in as <%= user.username %></p>
      <div class="button-group">
        <a href="/gallery" class="btn primary">View Gallery</a>
        <a href="/auth/logout" class="btn secondary">Logout</a>
      </div>
      <% } else { %>
      <p>Please login or register to access your S3 gallery</p>
      <div class="button-group">
        <a href="/auth/login" class="btn primary">Login</a>
        <a href="/auth/register" class="btn secondary">Register</a>
      </div>
      <% } %>
    </div>
  </body>
</html>
